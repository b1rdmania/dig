{
  "source": "setlistfm",
  "tier": "enrichment",
  "versioning": {
    "mode": "checkpoint",
    "key_field": "checkpoint_value"
  },
  "license": {
    "type": "api_terms",
    "notes": "Do not run bulk ingest until terms and caching policy are approved."
  },
  "datasets": [
    {
      "name": "artist_setlists",
      "entity_type": "artist",
      "priority": "high",
      "fields": ["id", "artist", "venue", "city", "country", "eventDate", "sets"]
    },
    {
      "name": "venue_timeline",
      "entity_type": "external",
      "priority": "low",
      "fields": ["venue", "city", "country", "eventDate"]
    }
  ],
  "output_contract": {
    "required": ["source", "source_id", "confidence", "match_method"],
    "format": "ndjson"
  }
}

