        "Mixed By",
        "Edit",
        "Dub",
        "Additional Production",
        "Engineer",
        "Mastered By",
        "Written By",
        "Vocals"
      ]
    },

    "rule_b": {
      "enabled": true,
      "role_allowlist": [
        "Remix",
        "Producer",
        "Mixed By",
        "Edit",
        "Dub",
        "Additional Production"
      ]
    },

    "group_members": {
      "enabled": true
    }
