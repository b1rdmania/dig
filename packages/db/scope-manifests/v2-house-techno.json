{
  "id": "v2-house-techno",
  "version": "1.0.0",
  "description": "House + techno + adjacent edge styles, 1985-2003. Mirrors the original v2 build defaults.",

  "scope": {
    "year_min": 1985,
    "year_max": 2003,
    "use_default_styles": false,
    "styles": [
      "Acid House", "Acid Techno", "Chicago House", "Deep House", "Detroit Techno",
      "Dub Techno", "Garage House", "Hard House", "House", "Minimal",
      "Minimal Techno", "Progressive House", "Tech House", "Techno", "Tribal House",
      "Electro",
      "IDM", "Experimental", "Abstract",
      "Ambient", "Drone", "Dub",
      "Breakbeat", "Hardcore",
      "Italo-Disco",
      "Trance", "Goa Trance",
      "Electroclash", "Leftfield", "Balearic"
    ],
    "quality_active_only": true,
    "breakbeat_year_gate": 1994,
    "scene_weight_min": 0
  },

  "credits": {
