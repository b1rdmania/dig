# Ephemeral runner image for scripts/build-scoped-db.ts.
# Used by the dig-scope-runner Fly app to execute the slim scope build
# from inside Fly's private network (low-latency to dig-db.flycast and
# dig-db-scene.flycast) so the build is not affected by laptop sleep
# or local fly proxy disconnects.

FROM node:20-slim

# Tools we need at runtime: git for any in-flight repo updates (optional),
# postgresql-client for psql piping in phase 5, ca-certificates for TLS,
# tini as PID 1 so signals work cleanly when we shell into the box.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        postgresql-client \
        tini \
        curl \
 && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.27.0 --activate

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY tsconfig.base.json ./

COPY packages/db/package.json packages/db/
COPY packages/domain/package.json packages/domain/
COPY apps/api/package.json apps/api/
COPY apps/mcp/package.json apps/mcp/

RUN pnpm install --frozen-lockfile

COPY packages/ packages/
COPY apps/api/ apps/api/
COPY apps/mcp/ apps/mcp/
COPY scripts/ scripts/

ENV NODE_ENV=production

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
