{
  "name": "dig",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --filter @dig/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @dig/web dev",
    "build:web": "pnpm --filter @dig/web build",
    "benchmark:search": "npx tsx apps/api/src/benchmark.ts --base-url http://localhost:3002",
    "smoke:regression": "pnpm exec tsx scripts/regression-smoke.ts",
    "audit:migrations": "pnpm exec tsx scripts/migration-parity-audit.ts",
    "sweep:404": "pnpm exec tsx scripts/route-404-sweep.ts",
    "scope:90s:report": "pnpm exec tsx scripts/scoped-catalog-report.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@types/node": "^25.3.0",
    "eslint": "^10.4.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.61.0"
  }
}
